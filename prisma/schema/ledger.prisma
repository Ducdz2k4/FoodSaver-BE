enum LedgerAccountType {
  GATEWAY_CLEARING
  ESCROW
  PARTNER_PENDING
  PARTNER_WALLET
  PLATFORM_REVENUE
  REFUND_PAYABLE
  PAYOUT_CLEARING
  PARTNER_RECEIVABLE
}

enum EntryType {
  DEBIT
  CREDIT
}

model LedgerAccount {
  id          String            @id @default(uuid())
  code        String            @unique @db.VarChar(50)
  type        LedgerAccountType
  partnerId   String?           @db.VarChar(36)
  name        String            @db.VarChar(100)
  currency    String            @default("VND") @db.VarChar(10)
  balance     Decimal           @default(0) @db.Decimal(14, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  entries     LedgerEntry[]

  @@index([partnerId])
  @@index([type])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String    @id @default(uuid())
  transactionNo  String    @unique @db.VarChar(50)
  idempotencyKey String?   @unique @db.VarChar(100)
  orderId        String?   @db.VarChar(36)
  type           String    @db.VarChar(50)
  amount         Decimal   @db.Decimal(14, 2)
  description    String?   @db.VarChar(255)
  createdAt      DateTime  @default(now())

  entries        LedgerEntry[]

  @@index([orderId])
  @@index([type])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id             String            @id @default(uuid())
  transactionId  String
  accountId      String
  entryType      EntryType
  amount         Decimal           @db.Decimal(14, 2)
  createdAt      DateTime          @default(now())

  transaction    LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account        LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

model PartnerWallet {
  id               String   @id @default(uuid())
  partnerId        String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(14, 2)
  pendingBalance   Decimal  @default(0) @db.Decimal(14, 2)
  currency         String   @default("VND") @db.VarChar(10)
  updatedAt        DateTime @updatedAt

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_wallets")
}

model PartnerReceivable {
  id          String   @id @default(uuid())
  partnerId   String   @unique
  debtBalance Decimal  @default(0) @db.Decimal(14, 2)
  debtLimit   Decimal  @default(500000.00) @db.Decimal(14, 2)
  isSuspended Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_receivables")
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

model Payout {
  id             String       @id @default(uuid())
  payoutNumber   String       @unique @db.VarChar(36)
  partnerId      String
  amount         Decimal      @db.Decimal(14, 2)
  bankName       String?      @db.VarChar(100)
  bankAccountNo  String?      @db.VarChar(50)
  bankAccountName String?     @db.VarChar(100)
  status         PayoutStatus @default(REQUESTED)
  idempotencyKey String?      @unique @db.VarChar(100)
  processedAt    DateTime?
  rejectionReason String?     @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@map("payouts")
}
