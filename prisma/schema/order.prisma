enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  ACCEPTED
  PREPARING
  READY
  HANDED_OVER
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
  DISPUTED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  STORE_PICKUP
  PARTNER_DELIVERY
}

enum PaymentMethod {
  COD
  SYSTEM_QR
  CASH
  ONLINE
}

model Order {
  id                     String            @id @default(uuid())
  orderNumber            String            @unique @db.VarChar(32)
  listingId              String
  customerId             String
  quantity               Int               @default(1)
  unitPrice              Decimal           @db.Decimal(12, 2)
  merchandiseTotal       Decimal           @default(0) @db.Decimal(12, 2)
  serviceFee             Decimal           @default(0) @db.Decimal(12, 2)
  serviceFeePercentage   Decimal           @default(10.00) @db.Decimal(5, 2)
  totalPrice             Decimal           @db.Decimal(12, 2)
  status                 OrderStatus       @default(PENDING)
  paymentStatus          PaymentStatus     @default(PENDING)
  reservationStatus      ReservationStatus @default(RESERVED)
  fulfillmentType        FulfillmentType   @default(PICKUP)
  paymentMethod          PaymentMethod     @default(COD)
  deliveryAddress        String?           @db.VarChar(255)
  deliveryDistance       Decimal?          @db.Decimal(5, 2)
  shippingFee            Decimal           @default(0) @db.Decimal(12, 2)
  negotiatedShippingFee  Decimal?          @db.Decimal(12, 2)
  discountCode           String?           @db.VarChar(50)
  discountAmount         Decimal           @default(0) @db.Decimal(12, 2)
  isLocked               Boolean           @default(false)
  lockedAt               DateTime?
  pickupTimeWindow       String            @db.VarChar(100)
  pickupOtp              String?           @db.VarChar(6)
  pickupQrCode           String?           @db.VarChar(100)
  partnerConfirmedAt     DateTime?
  customerConfirmedAt    DateTime?
  handedOverAt           DateTime?
  completedAt            DateTime?
  disputedAt             DateTime?
  customerNotes          String?           @db.VarChar(255)
  customerPhone          String?           @db.VarChar(20)
  cancellationReason     String?           @db.VarChar(255)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  listing      Listing                 @relation(fields: [listingId], references: [id], onDelete: Restrict)
  customer     User                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  history      OrderStatusHistory[]
  reservations InventoryReservation[]
  payments     Payment[]
  chatThread   OrderChatThread?
  callEvents   OrderCallEvent[]

  @@index([listingId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentType])
  @@map("orders")
}

model OrderStatusHistory {
  id        String       @id @default(uuid())
  orderId   String
  oldStatus OrderStatus?
  newStatus OrderStatus
  changedBy String       @db.VarChar(36)
  note      String?      @db.VarChar(255)
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}
