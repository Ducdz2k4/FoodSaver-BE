# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (MongoDB / PostgreSQL / MySQL)
# Example: mongodb://localhost:27017/foodsaver
DATABASE_URL=mongodb://localhost:27017/foodsaver

# Authentication / JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
