# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:4000,http://localhost:3000,http://localhost:5173

# MySQL Database (Docker / Local)
DATABASE_URL="mysql://foodsaver_user:foodsaver_password@localhost:3306/foodsaver_db"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_foodsaver_2026_secure
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_foodsaver_2026
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# TypeSafe AI - Jev System One Model
JEV_API_KEY=your_jev_api_key
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Groq LLM - Generative Model (e.g. openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1

# SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_gmail_app_password

# Google OAuth Web Client ID (same value in FE and BE)
GOOGLE_CLIENT_ID=your_google_web_client_id
